# 统一换行行为：仓库内一律存 LF，检出时按下述规则
* text=auto

# Windows 脚本保持 CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf

# WSL / Python / Shell 侧保持 LF
*.sh text eol=lf
*.py text eol=lf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.zip binary
*.jar binary
