# Copy to .env, or let scripts/Load-Env.ps1 generate INTERNAL_TOKEN automatically.
INTERNAL_TOKEN=
DB_USERNAME=book_agent
DB_PASSWORD=book_agent123
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_PUBLIC_URL=http://127.0.0.1:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin123456
AI_URL=http://127.0.0.1:8100
# Primary chat: qwen3.8-flash at DashScope compatible-mode/v1.
# Set DASHSCOPE_API_KEY in the Windows USER environment (read by Start-AI.ps1).
# On Linux inject DASHSCOPE_API_KEY into the service environment.
# Optional fallback channels; Ollama requires OLLAMA_ENABLED=true.
DEEPSEEK_API_KEY=
QWEN_API_KEY=
GLM_API_KEY=
OLLAMA_ENABLED=false
# Required for private Book RAG; Setup-RAG.ps1 provisions an isolated database.
PGVECTOR_DSN=
# remote defaults to text-embedding-v4, 1024 dimensions, using DASHSCOPE_API_KEY.
# local uses FastEmbed BAAI/bge-small-zh-v1.5 (512 dimensions, first-use download).
EMBEDDING_PROVIDER=remote
# Optional remote embedding overrides:
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
